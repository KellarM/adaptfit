{
  "name": "HealthProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "First name used for greetings"
    },
    "age": {
      "type": "number"
    },
    "height_cm": {
      "type": "number"
    },
    "experience": {
      "type": "string",
      "enum": [
        "starting",
        "returning",
        "intermediate"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "description": "Strength training experience"
    },
    "goals": {
      "type": "array",
      "description": "Goal keys: strength, muscle, mobility, fat_loss, conditioning, pain_free"
    },
    "weekly_target": {
      "type": "number",
      "description": "Sessions per week"
    },
    "session_minutes": {
      "type": "number"
    },
    "conditions": {
      "type": "string",
      "description": "Current health factors"
    },
    "conditions_text": {
      "type": "string",
      "description": "The person's own description of their conditions and injuries"
    },
    "conditions_summary": {
      "type": "string",
      "description": "Plain-language summary of what was understood from the description"
    },
    "medications": {
      "type": "string"
    },
    "clinician_notes": {
      "type": "string",
      "description": "Advice from doctor or physiotherapist"
    },
    "measurement_unit": {
      "type": "string",
      "enum": [
        "in",
        "cm"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "default": "in",
      "description": "Preferred unit for tape measurements"
    },
    "setup_draft": {
      "type": "object",
      "description": "Setup answers saved while onboarding is still in progress, so a refresh loses nothing"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {},
  "required": []
}